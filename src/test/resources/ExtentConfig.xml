<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
	<configuration>
		<!-- report theme -->
		<!-- STANDARD, DARK -->
		<theme>DARK</theme>
		<!-- document encoding -->
		<!-- defaults to UTF-8 -->
		<encoding>UTF-8</encoding>
		<!-- protocol for script and stylesheets -->
		<!-- defaults to https -->
		<!-- HTTP, HTTPS -->
		<protocol>HTTPS</protocol>
		<!-- offline report -->
		<timelineEnabled>true</timelineEnabled>
		<!-- offline report -->
		<enableOfflineMode>false</enableOfflineMode>
		<!-- use thumbnails for base64 images -->
		<!-- this may slowdown viewing tests -->
		<thumbnailForBase64>false</thumbnailForBase64>
		<!-- title of the document -->
		<documentTitle>BirlaOpus</documentTitle>
		<!-- report name - displayed at top-nav -->
		<reportName>
    <![CDATA[
    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 7px 0;">
        <!-- Left logo: IDFC FIRST Bank -->
        <img src="https://assets.birlaopus.com/is/content/grasimindustries/birla-opus-logo-v1?ts=1731582213592&dpr=off" width="120" height="30" style="margin-right: 20px;" />
        <!-- Separator -->
        <div style="width: 2px; height: 30px; background-color: #ccc; margin: 0 20px;"></div>
        <!-- Right logo: Local DEPT logo -->
        <img src="https://www.deptagency.com/wp-content/uploads/2024/09/dept-logo.svg" width="100" height="30" style="margin-left: 20px;" />
    </div>
    ]]>
</reportName>


		<!-- timestamp format -->
		<timeStampFormat>MMM dd, yyyy HH:mm:ss</timeStampFormat>
		<!-- custom javascript -->
		<js>
             <![CDATA[
      $(document).ready(function() {
        document.getElementsByClassName('logo')[0].style.display='none';
        });
        ]]>
        </js>
		<!-- custom styles -->
		<css>
			     <![CDATA[
   		.badge-primary{background-color: #fff}
   		.badge-primary {color: #212529}
   		.header {background-color: #fff}
        ]]>			
			
		</css>
	</configuration>
</extentreports>